{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "./imageconfig.json",
  "title": "Sikker Selvbetjening ImageConfig Config",
  "description": "Schema for a single imageconfig configuration.",
  "$ref": "#/$defs/imageconfig_entry",
  "$defs": {
    "policy_file_base": {
      "type": "string",
      "pattern": "^(?:\\.\\./policies|policies)/.+\\.ya?ml$",
      "description": "Relative policy file path under policies/... (for example ../policies/bibliotek-selvbetjeningspc.yml).",
      "x-ssb-file": {
        "enabled": true,
        "assetPrefixTemplate": "../policies/"
      }
    },
    "imageconfig_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "policies", "image_id"],
      "properties": {
        "name": {
          "type": "string",
          "title": "Image Name",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "title": "Description",
          "description": "Optional description of the imageconfig",
          "minLength": 1
        },
        "policies": {
          "type": "array",
          "title": "Policies",
          "description": "List of relative policy file paths assigned to this imageconfig.",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/policy_file_base"
          },
          "uniqueItems": true
        },
        "image_id": {
          "type": "string",
          "title": "Image Name",
          "description": "Identifier-safe image key for automation.",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        }
      }
    }
  }
}

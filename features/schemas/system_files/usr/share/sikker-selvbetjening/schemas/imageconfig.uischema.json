{
  "ui:submitButtonOptions": {
    "norender": false
  },
  "ui:order": [
    "name",
    "description",
    "policies",
    "image_id"
  ],
  "name": {
    "ui:placeholder": "Boernebibliotek"
  },
  "description": {
    "ui:widget": "textarea",
    "ui:options": {
      "rows": 3
    },
    "ui:placeholder": "Optional description of this image configuration"
  },
  "policies": {
    "ui:field": "policyReferenceSelect",
    "ui:options": {
      "policyFile": {
        "enabled": true,
        "accept": ".yml,.yaml,text/yaml,application/x-yaml",
        "assetPrefixTemplate": "../policies/"
      }
    }
  },
  "image_id": {
    "ui:placeholder": "selvbetjeningspc_sonderborg_boernebibliotek"
  }
}
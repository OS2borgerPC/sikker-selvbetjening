#!/usr/bin/env bash
# Build one image by validating config, rendering overlay files,
# running podman build, and creating derived local tags.
#
# Required positional arguments:
#   1) imageconfig_file   Path to imageconfig YAML file.
#   2) policies_root      Directory containing policy YAML files.
#   3) assets_root        Directory containing referenced assets.
#   4) target_image_ref   Fully qualified image ref (example: ghcr.io/org/name:tag).
#
# Required environment variables:
#   BASE_IMAGE            Base image used in the final build.
#
# Optional environment variables:
#   SIKKER_OUTPUT_ROOT        Staging output directory (default: /tmp/sikker-overlay-output)
#   SIKKER_OVERLAY_PLAYBOOK_DIR  Overlay playbook directory (default: /usr/libexec/sikker-overlay)
#   SIKKER_SCHEMA_DIR         JSON schema directory (default: /usr/share/sikker-selvbetjening/schemas)
#   GITHUB_SHA                Commit SHA used to derive an immutable sha-* tag.
#
# Flow:
#   1) Validate imageconfig and referenced policy files.
#   2) Render overlay content into the staging output root.
#   3) Build target_image_ref from BASE_IMAGE with staged /usr and /etc content.
#   4) Create date/sha-derived local tags and print them for caller-side push.
set -euo pipefail

die() {
	echo "$*" >&2
	exit 1
}

IMAGECONFIG_FILE="${1:?imageconfig file required}"
POLICIES_ROOT="${2:?policies root required}"
ASSETS_ROOT="${3:?assets root required}"
TARGET_IMAGE_REF="${4:?target image ref required}"
OUTPUT_ROOT="${SIKKER_OUTPUT_ROOT:-/tmp/sikker-overlay-output}"
BASE_IMAGE="${BASE_IMAGE:?BASE_IMAGE must be set}"
OVERLAY_PLAYBOOK_ROOT="${SIKKER_OVERLAY_PLAYBOOK_DIR:-/usr/libexec/sikker-overlay}"
PLAYBOOK_FILE="${OVERLAY_PLAYBOOK_ROOT}/sikker-assemble-overlay.yml"
ANSIBLE_CONFIG_FILE="${OVERLAY_PLAYBOOK_ROOT}/ansible.cfg"
SCHEMA_ROOT="${SIKKER_SCHEMA_DIR:-/usr/share/sikker-selvbetjening/schemas}"
IMAGECONFIG_SCHEMA_FILE="${SCHEMA_ROOT}/imageconfig.json"
POLICY_SCHEMA_FILE="${SCHEMA_ROOT}/policy.json"

[[ -f "${IMAGECONFIG_FILE}" ]] || die "Missing imageconfig file: ${IMAGECONFIG_FILE}"
[[ -d "${POLICIES_ROOT}" ]] || die "Missing policies root directory: ${POLICIES_ROOT}"
[[ -d "${ASSETS_ROOT}" ]] || die "Missing assets root directory: ${ASSETS_ROOT}"
[[ -d "${OVERLAY_PLAYBOOK_ROOT}" ]] || die "Missing overlay playbook directory: ${OVERLAY_PLAYBOOK_ROOT}"
[[ -f "${PLAYBOOK_FILE}" ]] || die "Missing validation playbook: ${PLAYBOOK_FILE}"
[[ -f "${IMAGECONFIG_SCHEMA_FILE}" ]] || die "Missing imageconfig schema: ${IMAGECONFIG_SCHEMA_FILE}"
[[ -f "${POLICY_SCHEMA_FILE}" ]] || die "Missing policy schema: ${POLICY_SCHEMA_FILE}"
command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook is not installed"
command -v python3 >/dev/null 2>&1 || die "python3 is not installed"
command -v podman >/dev/null 2>&1 || die "podman is not installed"
[[ "${TARGET_IMAGE_REF}" =~ .+/.+:.+ ]] || die "target_image_ref must include repository path and tag (example: ghcr.io/org/name:latest)"

export ANSIBLE_CONFIG="${ANSIBLE_CONFIG_FILE}"
export ANSIBLE_NOCOWS=1

ansible-playbook \
	-i localhost, \
	-c local \
	"${PLAYBOOK_FILE}" \
	--extra-vars "imageconfig_file=${IMAGECONFIG_FILE}" \
	--extra-vars "policies_root=${POLICIES_ROOT}" \
	--extra-vars "assets_root=${ASSETS_ROOT}" \
	--extra-vars "output_root=${OUTPUT_ROOT}" \
	--extra-vars "imageconfig_schema_file=${IMAGECONFIG_SCHEMA_FILE}" \
	--extra-vars "policy_schema_file=${POLICY_SCHEMA_FILE}"

mkdir -p "${OUTPUT_ROOT}/usr" "${OUTPUT_ROOT}/etc"

podman build \
	-t "${TARGET_IMAGE_REF}" \
	-f - \
	"${OUTPUT_ROOT}" <<EOF
FROM ${BASE_IMAGE}
COPY usr/ /usr/
COPY etc/ /etc/
EOF

echo "Built image: ${TARGET_IMAGE_REF}"

IMAGE_REF_BASE="${TARGET_IMAGE_REF%:*}"
PRIMARY_TAG="${TARGET_IMAGE_REF##*:}"
DATE_TAG="$(date -u +%Y%m%d)"
SHA_TAG=""

if [[ -n "${GITHUB_SHA:-}" ]]; then
	SHA_TAG="sha-${GITHUB_SHA:0:7}"
fi

TAGS=("${PRIMARY_TAG}")
if [[ "${PRIMARY_TAG}" == "latest" ]]; then
	TAGS+=("latest.${DATE_TAG}" "${DATE_TAG}")
else
	TAGS+=("${PRIMARY_TAG}.${DATE_TAG}" "${DATE_TAG}")
fi

if [[ -n "${SHA_TAG}" ]]; then
	TAGS+=("${SHA_TAG}")
fi

declare -A seen_tags=()
resolved_push_refs=()
for tag in "${TAGS[@]}"; do
	if [[ -n "${seen_tags[${tag}]:-}" ]]; then
		continue
	fi
	seen_tags["${tag}"]=1

	target_ref="${IMAGE_REF_BASE}:${tag}"
	if [[ "${tag}" != "${PRIMARY_TAG}" ]]; then
		podman tag "${TARGET_IMAGE_REF}" "${target_ref}"
	fi
	resolved_push_refs+=("${target_ref}")
done

echo "PUSH_REFS_BEGIN"
for ref in "${resolved_push_refs[@]}"; do
	echo "${ref}"
done
echo "PUSH_REFS_END"

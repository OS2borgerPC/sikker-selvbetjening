#!/usr/bin/env bash
# Validates imageconfig and referenced policy YAML files, then renders overlay tasks.
# Expects: imageconfig file, policies root directory, and assets root directory.
# Optional 4th arg: output root (default: /tmp/sikker-overlay-output).
set -euo pipefail

die() {
	echo "$*" >&2
	exit 1
}

IMAGECONFIG_FILE="${1:?imageconfig file required}"
POLICIES_ROOT="${2:?policies root required}"
ASSETS_ROOT="${3:?assets root required}"
OUTPUT_ROOT="${4:-${SIKKER_OUTPUT_ROOT:-/tmp/sikker-overlay-output}}"
OVERLAY_PLAYBOOK_ROOT="${SIKKER_OVERLAY_PLAYBOOK_DIR:-/usr/libexec/sikker-overlay}"
PLAYBOOK_FILE="${OVERLAY_PLAYBOOK_ROOT}/sikker-validate-config.yml"
ANSIBLE_CONFIG_FILE="${OVERLAY_PLAYBOOK_ROOT}/ansible.cfg"
SCHEMA_ROOT="${SIKKER_SCHEMA_DIR:-/usr/share/sikker-selvbetjening/schemas}"
IMAGECONFIG_SCHEMA_FILE="${SCHEMA_ROOT}/imageconfig.json"
POLICY_SCHEMA_FILE="${SCHEMA_ROOT}/policy.json"
MERGED_POLICY_FILE="${SIKKER_MERGED_POLICY_FILE:-/tmp/$(basename "${IMAGECONFIG_FILE%.*}").merged-policy.json}"

[[ -f "${IMAGECONFIG_FILE}" ]] || die "Missing imageconfig file: ${IMAGECONFIG_FILE}"
[[ -d "${POLICIES_ROOT}" ]] || die "Missing policies root directory: ${POLICIES_ROOT}"
[[ -d "${ASSETS_ROOT}" ]] || die "Missing assets root directory: ${ASSETS_ROOT}"
[[ -d "${OVERLAY_PLAYBOOK_ROOT}" ]] || die "Missing overlay playbook directory: ${OVERLAY_PLAYBOOK_ROOT}"
[[ -f "${PLAYBOOK_FILE}" ]] || die "Missing validation playbook: ${PLAYBOOK_FILE}"
[[ -f "${IMAGECONFIG_SCHEMA_FILE}" ]] || die "Missing imageconfig schema: ${IMAGECONFIG_SCHEMA_FILE}"
[[ -f "${POLICY_SCHEMA_FILE}" ]] || die "Missing policy schema: ${POLICY_SCHEMA_FILE}"
command -v ansible-playbook >/dev/null 2>&1 || die "ansible-playbook is not installed"
command -v python3 >/dev/null 2>&1 || die "python3 is not installed"
command -v jq >/dev/null 2>&1 || die "jq is not installed"

export ANSIBLE_CONFIG="${ANSIBLE_CONFIG_FILE}"
export ANSIBLE_NOCOWS=1

ansible-playbook \
	-i localhost, \
	-c local \
	"${PLAYBOOK_FILE}" \
	--extra-vars "imageconfig_file=${IMAGECONFIG_FILE}" \
	--extra-vars "policies_root=${POLICIES_ROOT}" \
	--extra-vars "assets_root=${ASSETS_ROOT}" \
	--extra-vars "output_root=${OUTPUT_ROOT}" \
	--extra-vars "merged_policy_file=${MERGED_POLICY_FILE}" \
	--extra-vars "imageconfig_schema_file=${IMAGECONFIG_SCHEMA_FILE}" \
	--extra-vars "policy_schema_file=${POLICY_SCHEMA_FILE}"
